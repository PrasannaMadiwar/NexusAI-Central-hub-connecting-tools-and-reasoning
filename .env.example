# ==============================================================================
# NexusAI Production Multi-Tenant Environment Variables
# ==============================================================================

# Core AI Models
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...

# Supabase PostgreSQL (Checkpoints, Thread State, and Chat History)
# Get from: Supabase Dashboard -> Project Settings -> Database -> Connection URI
SUPABASE_POSTGRES_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Auth / OAuth2 JWT Secret
# Get from: Supabase Dashboard -> Project Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# MongoDB Server (AES-256 Encrypted User Credentials)
# Get from: MongoDB Atlas -> Clusters -> Connect -> Connection String
MONGO_URI=mongodb+srv://[USER]:[PASSWORD]@[CLUSTER].mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=nexusai

# Encryption Key for Credentials (32-byte Fernet AES-256 base64 string)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Daytona Sandbox (Lazy Python Code Execution)
DAYTONA_API_KEY=

# Server Configuration
PORT=8000
